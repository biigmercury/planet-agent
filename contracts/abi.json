    ]
  },
  {
    "type": "event",
    "name": "WagerSettled",
    "anonymous": false,
    "inputs": [
      { "indexed": true, "name": "wagerId", "type": "uint256" },
      { "indexed": true, "name": "winner", "type": "address" },
      { "indexed": false, "name": "isDraw", "type": "bool" }
    ]
