      { "name": "wagerId", "type": "uint256" }
    ],
    "outputs": []
  },
  {
    "type": "function",
    "name": "claimWithAttestation",
    "stateMutability": "nonpayable",
    "inputs": [
      { "name": "wagerId", "type": "uint256" },
      { "name": "winner", "type": "address" },
      { "name": "deadline", "type": "uint256" },
      { "name": "signature", "type": "bytes" }
    ],
    "outputs": []
  },
  {
    "type": "function",
    "name": "claimDraw",
    "stateMutability": "nonpayable",
    "inputs": [
      { "name": "wagerId", "type": "uint256" },
      { "name": "deadline", "type": "uint256" },
      { "name": "signature", "type": "bytes" }
    ],
    "outputs": []
